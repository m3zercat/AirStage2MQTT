# Image used by Docker Compose. Set this to a registry reference after publishing.
A2M_IMAGE=airstage2mqtt:local

# MQTT connection. A2M_MQTT_PASSWORD_FILE takes precedence over A2M_MQTT_PASSWORD.
A2M_MQTT_HOST=192.168.1.10
A2M_MQTT_PORT=1883
A2M_MQTT_USERNAME=airstage2mqtt
A2M_MQTT_PASSWORD=change-me
# A2M_MQTT_PASSWORD_FILE=/run/secrets/mqtt_password
A2M_MQTT_TLS=false
# A2M_MQTT_TLS_CA_FILE=/run/secrets/mqtt_ca.pem
# A2M_MQTT_TLS_INSECURE=false
A2M_BASE_TOPIC=airstage2mqtt

# Application paths and logging.
A2M_CONFIG=/config/config.yaml
A2M_DATA_DIR=/data
A2M_LOG_LEVEL=INFO
